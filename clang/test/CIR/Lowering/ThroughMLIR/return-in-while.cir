// return nested in a while(1) (mips shape): lowered to single-exit with a
// `returning` flag; the while condition is strengthened so the loop exits.
//
// RUN: cir-opt %s --cir-lower-return | FileCheck %s
// RUN: cir-opt %s --cir-lower-return --cir-canonicalize --cir-to-mlir | FileCheck %s --check-prefix=SCF

!s32i = !cir.int<s, 32>
module {
  cir.func @f(%arg0: !s32i {llvm.noundef}) -> !s32i {
    %0 = cir.alloca "x" align(4) init : !cir.ptr<!s32i>
    %1 = cir.alloca "__retval" align(4) : !cir.ptr<!s32i>
    %2 = cir.alloca "r" align(4) init : !cir.ptr<!s32i>
    cir.store %arg0, %0 : !s32i, !cir.ptr<!s32i>
    %3 = cir.const #cir.int<0> : !s32i
    cir.store align(4) %3, %2 : !s32i, !cir.ptr<!s32i>
    cir.scope {
      cir.while {
        %5 = cir.const #cir.int<1> : !s32i
        %6 = cir.cast int_to_bool %5 : !s32i -> !cir.bool
        cir.condition(%6)
      } do {
        cir.scope {
          %5 = cir.load align(4) %2 : !cir.ptr<!s32i>, !s32i
          %6 = cir.inc nsw %5 : !s32i
          cir.store align(4) %6, %2 : !s32i, !cir.ptr<!s32i>
          cir.scope {
            %7 = cir.load align(4) %2 : !cir.ptr<!s32i>, !s32i
            %8 = cir.load align(4) %0 : !cir.ptr<!s32i>, !s32i
            %9 = cir.cmp gt %7, %8 : !s32i
            cir.if %9 {
              %10 = cir.load align(4) %2 : !cir.ptr<!s32i>, !s32i
              cir.store %10, %1 : !s32i, !cir.ptr<!s32i>
              %11 = cir.load %1 : !cir.ptr<!s32i>, !s32i
              cir.return %11 : !s32i
            }
          }
        }
        cir.yield
      }
    }
    %4 = cir.load %1 : !cir.ptr<!s32i>, !s32i
    cir.return %4 : !s32i
  }
}

// CHECK: cir.alloca {{.*}}"returning"
// CHECK: cir.alloca {{.*}}"retval"
// CHECK: cir.while {
// CHECK: cir.ternary
// CHECK: cir.const #false
// CHECK: cir.condition
// A single func-level return remains after lowering.
// SCF: func.func @f
// SCF: scf.while
// SCF: return
