// SEQUENTIAL REBINDING (the blowfish BF_set_key shape): one pointer variable
// reused for two bases in straight-line entry-block code. Every rebind store
// sits in the entry block, so op order gives exact reaching definitions and
// each load takes the root of its nearest preceding rebind. This is NOT a
// control-flow merge and is rewritten (per-load roots), not rejected.
//
// RUN: cir-opt %s --cir-lower-pointer-cursors | FileCheck %s

!s32i = !cir.int<s, 32>
module {
  cir.global external @ga = #cir.zero : !cir.array<!s32i x 4>
  cir.global external @gb = #cir.zero : !cir.array<!s32i x 4>
  cir.func @rebind() -> !s32i {
    %p = cir.alloca "p" align(8) : !cir.ptr<!cir.ptr<!s32i>>
    %g1 = cir.get_global @ga : !cir.ptr<!cir.array<!s32i x 4>>
    %d1 = cir.cast array_to_ptrdecay %g1 : !cir.ptr<!cir.array<!s32i x 4>> -> !cir.ptr<!s32i>
    cir.store align(8) %d1, %p : !cir.ptr<!s32i>, !cir.ptr<!cir.ptr<!s32i>>
    %0 = cir.load deref align(8) %p : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
    %1 = cir.load align(4) %0 : !cir.ptr<!s32i>, !s32i
    %g2 = cir.get_global @gb : !cir.ptr<!cir.array<!s32i x 4>>
    %d2 = cir.cast array_to_ptrdecay %g2 : !cir.ptr<!cir.array<!s32i x 4>> -> !cir.ptr<!s32i>
    cir.store align(8) %d2, %p : !cir.ptr<!s32i>, !cir.ptr<!cir.ptr<!s32i>>
    %2 = cir.load deref align(8) %p : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
    %3 = cir.load align(4) %2 : !cir.ptr<!s32i>, !s32i
    %4 = cir.add %1, %3 : !s32i
    cir.return %4 : !s32i
  }
}

// CHECK-NOT: !cir.ptr<!cir.ptr<!s32i>>
// The first load resolves to @ga, the second to @gb.
// CHECK: cir.get_global @ga
// CHECK: cir.get_element {{.*}} : !cir.ptr<!cir.array<!s32i x 4>> -> !cir.ptr<!s32i>
// CHECK: cir.get_global @gb
// CHECK: cir.get_element {{.*}} : !cir.ptr<!cir.array<!s32i x 4>> -> !cir.ptr<!s32i>
