// CROSS-FEATURE: pointer cursor x GOTO. A forward goto out of a cursor loop
// (single-epilogue exit) goes through --cir-flatten-scope-goto after the
// cursor rewrite; the chain lowers to memref/scf.
//
// C shape: while(p<end){ if(*p==4) goto done; s+=*p; p++; } done: return s;
//
// RUN: cir-opt %s --cir-lower-pointer-cursors --cir-flatten-scope-goto --cir-goto-solver --cir-canonicalize --cir-lower-break-continue --cir-lower-return --cir-canonicalize --cir-to-mlir | FileCheck %s

!s32i = !cir.int<s, 32>
!s64i = !cir.int<s, 64>
module {
  cir.func  @f() -> !s32i {
    %0 = cir.alloca "a" align(16) : !cir.ptr<!cir.array<!s32i x 8>>
    %1 = cir.alloca "p" align(8) init : !cir.ptr<!cir.ptr<!s32i>>
    %2 = cir.alloca "end" align(8) init : !cir.ptr<!cir.ptr<!s32i>>
    %3 = cir.alloca "s" align(4) init : !cir.ptr<!s32i>
    cir.scope {
      %10 = cir.alloca "i" align(4) init : !cir.ptr<!s32i>
      %11 = cir.const #cir.int<0> : !s32i
      cir.store align(4) %11, %10 : !s32i, !cir.ptr<!s32i>
      cir.for : cond {
        %12 = cir.load align(4) %10 : !cir.ptr<!s32i>, !s32i
        %13 = cir.const #cir.int<8> : !s32i
        %14 = cir.cmp lt %12, %13 : !s32i
        cir.condition(%14)
      } body {
        %12 = cir.load align(4) %10 : !cir.ptr<!s32i>, !s32i
        %13 = cir.const #cir.int<1> : !s32i
        %14 = cir.add nsw %12, %13 : !s32i
        %15 = cir.load align(4) %10 : !cir.ptr<!s32i>, !s32i
        %16 = cir.cast integral %15 : !s32i -> !s64i
        %17 = cir.get_element %0[%16 : !s64i] : !cir.ptr<!cir.array<!s32i x 8>> -> !cir.ptr<!s32i>
        cir.store align(4) %14, %17 : !s32i, !cir.ptr<!s32i>
        cir.yield
      } step {
        %12 = cir.load align(4) %10 : !cir.ptr<!s32i>, !s32i
        %13 = cir.inc nsw %12 : !s32i
        cir.store align(4) %13, %10 : !s32i, !cir.ptr<!s32i>
        cir.yield
      }
    }
    %4 = cir.cast array_to_ptrdecay %0 : !cir.ptr<!cir.array<!s32i x 8>> -> !cir.ptr<!s32i>
    cir.store align(8) %4, %1 : !cir.ptr<!s32i>, !cir.ptr<!cir.ptr<!s32i>>
    %5 = cir.cast array_to_ptrdecay %0 : !cir.ptr<!cir.array<!s32i x 8>> -> !cir.ptr<!s32i>
    %6 = cir.const #cir.int<8> : !s32i
    %7 = cir.ptr_stride %5, %6 : (!cir.ptr<!s32i>, !s32i) -> !cir.ptr<!s32i>
    cir.store align(8) %7, %2 : !cir.ptr<!s32i>, !cir.ptr<!cir.ptr<!s32i>>
    %8 = cir.const #cir.int<0> : !s32i
    cir.store align(4) %8, %3 : !s32i, !cir.ptr<!s32i>
    cir.scope {
      cir.while {
        %10 = cir.load align(8) %1 : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
        %11 = cir.load align(8) %2 : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
        %12 = cir.cmp lt %10, %11 : !cir.ptr<!s32i>
        cir.condition(%12)
      } do {
        cir.scope {
          cir.scope {
            %17 = cir.load deref align(8) %1 : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
            %18 = cir.load align(4) %17 : !cir.ptr<!s32i>, !s32i
            %19 = cir.const #cir.int<4> : !s32i
            %20 = cir.cmp eq %18, %19 : !s32i
            cir.if %20 {
              cir.goto "done"
            }
          }
          %10 = cir.load deref align(8) %1 : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
          %11 = cir.load align(4) %10 : !cir.ptr<!s32i>, !s32i
          %12 = cir.load align(4) %3 : !cir.ptr<!s32i>, !s32i
          %13 = cir.add nsw %12, %11 : !s32i
          cir.store align(4) %13, %3 : !s32i, !cir.ptr<!s32i>
          %14 = cir.load align(8) %1 : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
          %15 = cir.const #cir.int<1> : !s32i
          %16 = cir.ptr_stride %14, %15 : (!cir.ptr<!s32i>, !s32i) -> !cir.ptr<!s32i>
          cir.store align(8) %16, %1 : !cir.ptr<!s32i>, !cir.ptr<!cir.ptr<!s32i>>
        }
        cir.yield
      }
    }
    cir.br ^bb1
  ^bb1:  // pred: ^bb0
    cir.label "done"
    %9 = cir.load align(4) %3 : !cir.ptr<!s32i>, !s32i
    cir.return %9 : !s32i
  }
}


// Fully lowered: no cir ops, no fat-pointer memrefs, integer loop machinery.
// CHECK: func.func @f
// CHECK-NOT: cir.
// CHECK-NOT: memref<1xmemref
// CHECK: return
