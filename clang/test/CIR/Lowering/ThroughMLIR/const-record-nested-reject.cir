// A `#cir.const_record` with a NESTED aggregate member (a struct-in-struct) is
// not flattened by the S4 homogeneous path -- recursing a nested record risks a
// mis-flattened tensor across padding boundaries -- so it is honestly REJECTED
// and left for the general struct-lowering cluster.
//
// RUN: cir-opt %s --cir-to-mlir -verify-diagnostics

!s32i = !cir.int<s, 32>
!inner = !cir.struct<"I" {!s32i, !s32i}>
!rec = !cir.struct<"N" {!s32i, !inner}>
module @m {
  // expected-error @+1 {{const-record global @n cannot be flattened}}
  cir.global constant external @n = #cir.const_record<{#cir.int<10> : !s32i, #cir.const_record<{#cir.int<1> : !s32i, #cir.int<2> : !s32i}> : !inner}> : !rec
}
