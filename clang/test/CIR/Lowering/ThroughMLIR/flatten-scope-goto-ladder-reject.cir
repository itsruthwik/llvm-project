// Multi-target forward dispatch (softfloat subFloat64Sigs ladder shape): a
// goto whose entry block does NOT fall through to the target label block (the
// labels form a chain, not one shared epilogue) is rejected. Sound structured
// lowering of the acyclic ladder is deferred to a dedicated structurizer.
//
// RUN: cir-opt %s --cir-flatten-scope-goto -verify-diagnostics

!s32i = !cir.int<s, 32>
!u32i = !cir.int<u, 32>
module {
  cir.func no_inline dso_local @ladder(%arg0: !s32i, %arg1: !s32i) -> !s32i {
    %0 = cir.alloca "a" align(4) init : !cir.ptr<!s32i>
    %1 = cir.alloca "b" align(4) init : !cir.ptr<!s32i>
    %2 = cir.alloca "r" align(4) init : !cir.ptr<!s32i>
    cir.store %arg0, %0 : !s32i, !cir.ptr<!s32i>
    cir.store %arg1, %1 : !s32i, !cir.ptr<!s32i>
    %3 = cir.const #cir.int<0> : !s32i
    cir.store align(4) %3, %2 : !s32i, !cir.ptr<!s32i>
    cir.scope {
      %11 = cir.load align(4) %0 : !cir.ptr<!s32i>, !s32i
      %12 = cir.const #cir.int<50> : !s32i
      %13 = cir.cmp gt %11, %12 : !s32i
      cir.if %13 {
        %14 = cir.load align(4) %0 : !cir.ptr<!s32i>, !s32i
        %15 = cir.load align(4) %1 : !cir.ptr<!s32i>, !s32i
        %16 = cir.add nsw %14, %15 : !s32i
        cir.store align(4) %16, %2 : !s32i, !cir.ptr<!s32i>
      // expected-error @+1 {{unsupported 'goto' (multi-target forward dispatch}}
        cir.goto "pack"
      }
    }
    cir.scope {
      %11 = cir.load align(4) %0 : !cir.ptr<!s32i>, !s32i
      %12 = cir.const #cir.int<0> : !s32i
      %13 = cir.cmp lt %11, %12 : !s32i
      cir.if %13 {
        %14 = cir.load align(4) %0 : !cir.ptr<!s32i>, !s32i
        %15 = cir.load align(4) %1 : !cir.ptr<!s32i>, !s32i
        %16 = cir.sub nsw %14, %15 : !s32i
        cir.store align(4) %16, %2 : !s32i, !cir.ptr<!s32i>
        cir.goto "norm"
      }
    }
    %4 = cir.load align(4) %1 : !cir.ptr<!s32i>, !s32i
    cir.store align(4) %4, %2 : !s32i, !cir.ptr<!s32i>
    cir.br ^bb1
  ^bb1:  // pred: ^bb0
    cir.label "norm"
    %5 = cir.load align(4) %2 : !cir.ptr<!s32i>, !s32i
    %6 = cir.const #cir.int<1> : !s32i
    %7 = cir.add nsw %5, %6 : !s32i
    cir.store align(4) %7, %2 : !s32i, !cir.ptr<!s32i>
    cir.br ^bb2
  ^bb2:  // pred: ^bb1
    cir.label "pack"
    %8 = cir.load align(4) %2 : !cir.ptr<!s32i>, !s32i
    %9 = cir.const #cir.int<3> : !s32i
    %10 = cir.mul nsw %8, %9 : !s32i
    cir.return %10 : !s32i
  }
}
