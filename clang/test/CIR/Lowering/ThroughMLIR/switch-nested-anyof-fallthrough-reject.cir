// P1 crash fix (R2 s5.c). An `any-of` (empty/fall-through) case whose shared
// fall-through chain contains a NESTED cir.switch and then falls through into a
// later case is consumed by more than one arm of the scf.index_switch. The
// non-last consumer would CLONE the chain -- and a cloned nested cir.switch that
// still needs conversion defeats the one-shot dialect-conversion driver, which
// used to ABORT ("dialect conversion attempted to replace a root operation that
// has no parent block", core dumped). The lowering now REJECTS this shape with a
// named diagnostic instead of crashing. (A single-consumer nested switch is
// moved, not cloned, and still lowers -- see switch-to-scf / switch-fallthrough.)
//
// RUN: not cir-opt %s --cir-to-mlir 2>&1 | FileCheck %s

!s32i = !cir.int<s, 32>
module {
  cir.func @t(%arg0: !s32i, %arg1: !s32i) -> !s32i {
    %0 = cir.alloca "x" align(4) init : !cir.ptr<!s32i>
    %1 = cir.alloca "y" align(4) init : !cir.ptr<!s32i>
    %2 = cir.alloca "r" align(4) init : !cir.ptr<!s32i>
    cir.store %arg0, %0 : !s32i, !cir.ptr<!s32i>
    cir.store %arg1, %1 : !s32i, !cir.ptr<!s32i>
    %3 = cir.const #cir.int<0> : !s32i
    cir.store %3, %2 : !s32i, !cir.ptr<!s32i>
    cir.scope {
      %5 = cir.load %0 : !cir.ptr<!s32i>, !s32i
      cir.switch(%5 : !s32i) {
        cir.case(anyof, [#cir.int<0> : !s32i, #cir.int<1> : !s32i]) {
          cir.scope {
            %6 = cir.load %1 : !cir.ptr<!s32i>, !s32i
            cir.switch(%6 : !s32i) {
              cir.case(equal, [#cir.int<5> : !s32i]) {
                %7 = cir.const #cir.int<10> : !s32i
                %8 = cir.load %2 : !cir.ptr<!s32i>, !s32i
                %9 = cir.add nsw %8, %7 : !s32i
                cir.store %9, %2 : !s32i, !cir.ptr<!s32i>
                cir.break
              }
              cir.case(default, []) {
                %7 = cir.const #cir.int<1> : !s32i
                %8 = cir.load %2 : !cir.ptr<!s32i>, !s32i
                %9 = cir.add nsw %8, %7 : !s32i
                cir.store %9, %2 : !s32i, !cir.ptr<!s32i>
                cir.yield
              }
              cir.yield
            }
          }
          cir.yield
        }
        cir.case(equal, [#cir.int<2> : !s32i]) {
          %6 = cir.const #cir.int<100> : !s32i
          %7 = cir.load %2 : !cir.ptr<!s32i>, !s32i
          %8 = cir.add nsw %7, %6 : !s32i
          cir.store %8, %2 : !s32i, !cir.ptr<!s32i>
          cir.break
        }
        cir.yield
      }
    }
    %4 = cir.load %2 : !cir.ptr<!s32i>, !s32i
    cir.return %4 : !s32i
  }
}

// CHECK: error: ThroughMLIR: a nested 'switch' inside a 'case' fall-through chain that is shared by multiple case values
