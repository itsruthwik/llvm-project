// return nested in two loops: BOTH loop conditions are strengthened with
// `returning` (a return breaks out of EVERY enclosing loop).
//
// RUN: cir-opt %s --cir-lower-return | FileCheck %s
// RUN: cir-opt %s --cir-lower-return --cir-canonicalize --cir-to-mlir | FileCheck %s --check-prefix=SCF

!s32i = !cir.int<s, 32>
module {
  cir.func @f(%arg0: !s32i {llvm.noundef}) -> !s32i {
    %0 = cir.alloca "x" align(4) init : !cir.ptr<!s32i>
    %1 = cir.alloca "__retval" align(4) : !cir.ptr<!s32i>
    cir.store %arg0, %0 : !s32i, !cir.ptr<!s32i>
    cir.scope {
      %4 = cir.alloca "i" align(4) init : !cir.ptr<!s32i>
      %5 = cir.const #cir.int<0> : !s32i
      cir.store align(4) %5, %4 : !s32i, !cir.ptr<!s32i>
      cir.for : cond {
        %6 = cir.load align(4) %4 : !cir.ptr<!s32i>, !s32i
        %7 = cir.load align(4) %0 : !cir.ptr<!s32i>, !s32i
        %8 = cir.cmp lt %6, %7 : !s32i
        cir.condition(%8)
      } body {
        cir.scope {
          cir.scope {
            %6 = cir.alloca "j" align(4) init : !cir.ptr<!s32i>
            %7 = cir.const #cir.int<0> : !s32i
            cir.store align(4) %7, %6 : !s32i, !cir.ptr<!s32i>
            cir.for : cond {
              %8 = cir.load align(4) %6 : !cir.ptr<!s32i>, !s32i
              %9 = cir.load align(4) %0 : !cir.ptr<!s32i>, !s32i
              %10 = cir.cmp lt %8, %9 : !s32i
              cir.condition(%10)
            } body {
              cir.scope {
                cir.scope {
                  %8 = cir.load align(4) %4 : !cir.ptr<!s32i>, !s32i
                  %9 = cir.load align(4) %6 : !cir.ptr<!s32i>, !s32i
                  %10 = cir.mul nsw %8, %9 : !s32i
                  %11 = cir.load align(4) %0 : !cir.ptr<!s32i>, !s32i
                  %12 = cir.cmp eq %10, %11 : !s32i
                  cir.if %12 {
                    %13 = cir.load align(4) %4 : !cir.ptr<!s32i>, !s32i
                    %14 = cir.const #cir.int<10> : !s32i
                    %15 = cir.mul nsw %13, %14 : !s32i
                    %16 = cir.load align(4) %6 : !cir.ptr<!s32i>, !s32i
                    %17 = cir.add nsw %15, %16 : !s32i
                    cir.store %17, %1 : !s32i, !cir.ptr<!s32i>
                    %18 = cir.load %1 : !cir.ptr<!s32i>, !s32i
                    cir.return %18 : !s32i
                  }
                }
              }
              cir.yield
            } step {
              %8 = cir.load align(4) %6 : !cir.ptr<!s32i>, !s32i
              %9 = cir.inc nsw %8 : !s32i
              cir.store align(4) %9, %6 : !s32i, !cir.ptr<!s32i>
              cir.yield
            }
          }
        }
        cir.yield
      } step {
        %6 = cir.load align(4) %4 : !cir.ptr<!s32i>, !s32i
        %7 = cir.inc nsw %6 : !s32i
        cir.store align(4) %7, %4 : !s32i, !cir.ptr<!s32i>
        cir.yield
      }
    }
    %2 = cir.const #cir.int<-1> : !s32i
    cir.store %2, %1 : !s32i, !cir.ptr<!s32i>
    %3 = cir.load %1 : !cir.ptr<!s32i>, !s32i
    cir.return %3 : !s32i
  }
}

// CHECK: cir.alloca {{.*}}"returning"
// Two condition-strengthening lazy ternaries, one per enclosing loop.
// CHECK: cir.ternary
// CHECK: cir.const #false
// CHECK: cir.ternary
// CHECK: cir.const #false
// SCF: func.func @f
// SCF: return
