// P0 regression (side-effecting DO-WHILE condition + early return). The
// `do { ... } while(n-- > 0)` post-condition has a side effect; an early return
// in the body must break out of the loop WITHOUT re-running the decrement.
// --cir-lower-return must strengthen the enclosing do-while lazily (sink the
// decrement into the ternary false region). Numeric oracle:
// incrementH-artifacts/oracle.sh (do_ndec_return.c, gcc 4 == pipeline).
//
// RUN: cir-opt %s --cir-goto-solver --cir-canonicalize --cir-lower-break-continue --cir-lower-return | FileCheck %s
// RUN: cir-opt %s --cir-goto-solver --cir-canonicalize --cir-lower-break-continue --cir-lower-return --cir-canonicalize --cir-to-mlir | FileCheck %s --check-prefix=SCF

!s32i = !cir.int<s, 32>
module {
  cir.func @f() -> !s32i {
    %0 = cir.alloca "__retval" align(4) : !cir.ptr<!s32i>
    %1 = cir.alloca "n" align(4) init : !cir.ptr<!s32i>
    %2 = cir.alloca "c" align(4) init : !cir.ptr<!s32i>
    %3 = cir.const #cir.int<5> : !s32i
    cir.store %3, %1 : !s32i, !cir.ptr<!s32i>
    %4 = cir.const #cir.int<0> : !s32i
    cir.store %4, %2 : !s32i, !cir.ptr<!s32i>
    cir.scope {
      cir.do {
        cir.scope {
          %7 = cir.load %2 : !cir.ptr<!s32i>, !s32i
          %8 = cir.inc nsw %7 : !s32i
          cir.store %8, %2 : !s32i, !cir.ptr<!s32i>
          %9 = cir.const #cir.int<2> : !s32i
          %10 = cir.cmp eq %8, %9 : !s32i
          cir.if %10 {
            %12 = cir.load %1 : !cir.ptr<!s32i>, !s32i
            cir.store %12, %0 : !s32i, !cir.ptr<!s32i>
            %13 = cir.load %0 : !cir.ptr<!s32i>, !s32i
            cir.return %13 : !s32i
          }
        }
        cir.yield
      } while {
        %7 = cir.load %1 : !cir.ptr<!s32i>, !s32i
        %8 = cir.dec nsw %7 : !s32i
        cir.store %8, %1 : !s32i, !cir.ptr<!s32i>
        %9 = cir.const #cir.int<0> : !s32i
        %10 = cir.cmp gt %7, %9 : !s32i
        cir.condition(%10)
      }
    }
    %5 = cir.load %1 : !cir.ptr<!s32i>, !s32i
    cir.store %5, %0 : !s32i, !cir.ptr<!s32i>
    %6 = cir.load %0 : !cir.ptr<!s32i>, !s32i
    cir.return %6 : !s32i
  }
}

// The do-while post-condition is strengthened lazily on the `returning` flag:
// the decrement is sunk into the ternary false region.
// CHECK: cir.do {
// CHECK: } while {
// CHECK: cir.ternary
// CHECK: }, false {
// CHECK: cir.dec
// CHECK: cir.store
// CHECK: cir.cmp gt
// CHECK: cir.yield
// CHECK: cir.condition

// SCF: scf.while
