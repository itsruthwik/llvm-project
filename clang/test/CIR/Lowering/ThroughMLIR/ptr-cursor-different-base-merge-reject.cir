// A control-flow MERGE of pointers into DIFFERENT base objects
// (`if (c) p = a; else p = b;`) has no single (base, index) form and is OUT
// in v1: honestly rejected by name, never silently miscompiled.
//
// RUN: not cir-opt %s --cir-lower-pointer-cursors 2>&1 | FileCheck %s

!s32i = !cir.int<s, 32>
module {
  cir.func @merge(%c: !cir.bool) -> !s32i {
    %a = cir.alloca "a" align(16) : !cir.ptr<!cir.array<!s32i x 8>>
    %b = cir.alloca "b" align(16) : !cir.ptr<!cir.array<!s32i x 8>>
    %p = cir.alloca "p" align(8) : !cir.ptr<!cir.ptr<!s32i>>
    cir.if %c {
      %d = cir.cast array_to_ptrdecay %a : !cir.ptr<!cir.array<!s32i x 8>> -> !cir.ptr<!s32i>
      cir.store align(8) %d, %p : !cir.ptr<!s32i>, !cir.ptr<!cir.ptr<!s32i>>
    } else {
      %d = cir.cast array_to_ptrdecay %b : !cir.ptr<!cir.array<!s32i x 8>> -> !cir.ptr<!s32i>
      cir.store align(8) %d, %p : !cir.ptr<!s32i>, !cir.ptr<!cir.ptr<!s32i>>
    }
    %0 = cir.load deref align(8) %p : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
    %1 = cir.load align(4) %0 : !cir.ptr<!s32i>, !s32i
    cir.return %1 : !s32i
  }
}

// CHECK: merges pointers into different base objects
