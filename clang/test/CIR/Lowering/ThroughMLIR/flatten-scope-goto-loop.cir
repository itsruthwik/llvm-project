// Cross-scope forward-exit goto OUT OF a loop: the goto jumps forward from
// inside a cir.for to a shared epilogue label at function-body level. Besides
// the flag + guard-climb, --cir-flatten-scope-goto strengthens the enclosing
// loop's condition with `cir.select if flag then false else C` (and guards the
// for-step) so the goto terminates the loop -- the same treatment as an early
// return that breaks out of the loop. Guards against the historical
// step-execution miscompile.
//
// RUN: cir-opt %s --cir-flatten-scope-goto | FileCheck %s
// RUN: cir-opt %s --cir-flatten-scope-goto --cir-goto-solver --cir-canonicalize --cir-lower-break-continue --cir-lower-return --cir-canonicalize --cir-to-mlir | FileCheck %s --check-prefix=SCF

// CHECK-LABEL: cir.func {{.*}}@loop_goto
// CHECK: cir.alloca "goto_done"
// CHECK-NOT: cir.goto
// Loop condition strengthened with a select on the flag.
// CHECK: cir.select

// SCF-LABEL: func.func @loop_goto
// SCF-NOT: cir.goto
// SCF: return
!s32i = !cir.int<s, 32>
!u32i = !cir.int<u, 32>
module {
  cir.func no_inline dso_local @loop_goto(%arg0: !s32i, %arg1: !s32i) -> !s32i {
    %0 = cir.alloca "n" align(4) init : !cir.ptr<!s32i>
    %1 = cir.alloca "t" align(4) init : !cir.ptr<!s32i>
    %2 = cir.alloca "r" align(4) init : !cir.ptr<!s32i>
    cir.store %arg0, %0 : !s32i, !cir.ptr<!s32i>
    cir.store %arg1, %1 : !s32i, !cir.ptr<!s32i>
    %3 = cir.const #cir.int<0> : !s32i
    cir.store align(4) %3, %2 : !s32i, !cir.ptr<!s32i>
    cir.scope {
      %10 = cir.alloca "i" align(4) init : !cir.ptr<!s32i>
      %11 = cir.const #cir.int<0> : !s32i
      cir.store align(4) %11, %10 : !s32i, !cir.ptr<!s32i>
      cir.for : cond {
        %12 = cir.load align(4) %10 : !cir.ptr<!s32i>, !s32i
        %13 = cir.load align(4) %0 : !cir.ptr<!s32i>, !s32i
        %14 = cir.cmp lt %12, %13 : !s32i
        cir.condition(%14)
      } body {
        cir.scope {
          %12 = cir.load align(4) %10 : !cir.ptr<!s32i>, !s32i
          %13 = cir.load align(4) %2 : !cir.ptr<!s32i>, !s32i
          %14 = cir.add nsw %13, %12 : !s32i
          cir.store align(4) %14, %2 : !s32i, !cir.ptr<!s32i>
          cir.scope {
            %15 = cir.load align(4) %2 : !cir.ptr<!s32i>, !s32i
            %16 = cir.load align(4) %1 : !cir.ptr<!s32i>, !s32i
            %17 = cir.cmp gt %15, %16 : !s32i
            cir.if %17 {
              cir.goto "done"
            }
          }
        }
        cir.yield
      } step {
        %12 = cir.load align(4) %10 : !cir.ptr<!s32i>, !s32i
        %13 = cir.inc nsw %12 : !s32i
        cir.store align(4) %13, %10 : !s32i, !cir.ptr<!s32i>
        cir.yield
      }
    }
    %4 = cir.load align(4) %2 : !cir.ptr<!s32i>, !s32i
    %5 = cir.const #cir.int<100> : !s32i
    %6 = cir.add nsw %4, %5 : !s32i
    cir.store align(4) %6, %2 : !s32i, !cir.ptr<!s32i>
    cir.br ^bb1
  ^bb1:  // pred: ^bb0
    cir.label "done"
    %7 = cir.load align(4) %2 : !cir.ptr<!s32i>, !s32i
    %8 = cir.const #cir.int<2> : !s32i
    %9 = cir.mul nsw %7, %8 : !s32i
    cir.return %9 : !s32i
  }
}
