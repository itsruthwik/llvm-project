// A homogeneous-leaf `#cir.const_record` struct global (two int arrays)
// flattens to a single flat `memref<N x i32>` dense global (S4). The leaf-type
// unification + leaf-count size gate make the flattening bit-exact; a mismatch
// against the record's ABI size is rejected rather than silently padded.
//
// RUN: cir-opt %s --cir-to-mlir | FileCheck %s

!s32i = !cir.int<s, 32>
!rec = !cir.struct<"LUT" {!cir.array<!s32i x 2>, !cir.array<!s32i x 2>}>
module @m {
  cir.global constant external @lut = #cir.const_record<{#cir.const_array<[#cir.int<10> : !s32i, #cir.int<20> : !s32i]> : !cir.array<!s32i x 2>, #cir.const_array<[#cir.int<30> : !s32i, #cir.int<40> : !s32i]> : !cir.array<!s32i x 2>}> : !rec
}

// CHECK: memref.global "public" constant @lut : memref<4xi32> = dense<[10, 20, 30, 40]>
