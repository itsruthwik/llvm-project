// A strided cursor (`p += 3`) is rewritten to index arithmetic with the same
// stride constant.
//
// RUN: cir-opt %s --cir-lower-pointer-cursors | FileCheck %s

!s32i = !cir.int<s, 32>
module {
  cir.func @h() -> !s32i {
    %a = cir.alloca "a" align(16) : !cir.ptr<!cir.array<!s32i x 12>>
    %p = cir.alloca "p" align(8) : !cir.ptr<!cir.ptr<!s32i>>
    %d = cir.cast array_to_ptrdecay %a : !cir.ptr<!cir.array<!s32i x 12>> -> !cir.ptr<!s32i>
    cir.store align(8) %d, %p : !cir.ptr<!s32i>, !cir.ptr<!cir.ptr<!s32i>>
    %0 = cir.load align(8) %p : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
    %k = cir.const #cir.int<3> : !s32i
    %1 = cir.ptr_stride %0, %k : (!cir.ptr<!s32i>, !s32i) -> !cir.ptr<!s32i>
    cir.store align(8) %1, %p : !cir.ptr<!s32i>, !cir.ptr<!cir.ptr<!s32i>>
    %2 = cir.load deref align(8) %p : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
    %3 = cir.load align(4) %2 : !cir.ptr<!s32i>, !s32i
    cir.return %3 : !s32i
  }
}

// CHECK-NOT: !cir.ptr<!cir.ptr<!s32i>>
// CHECK: %[[A:.+]] = cir.alloca "a"
// CHECK: cir.const #cir.int<3> : !s32i
// CHECK: cir.add %{{.+}}, %{{.+}} : !s32i
// CHECK: cir.get_element %[[A]][{{.*}}]
