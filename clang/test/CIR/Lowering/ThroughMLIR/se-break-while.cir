// P0 regression (side-effecting loop condition + break). The while condition
// `n-- > 0` has a SIDE EFFECT (the decrement + store). After break fires, real
// C never re-evaluates the condition, so the decrement must NOT run again.
// --cir-lower-break-continue must strengthen the condition LAZILY: `brk ? false
// : C`, with the whole side-effecting computation of C SUNK into the ternary's
// false region so it only runs while brk is clear. A non-short-circuit
// cir.select over an already-computed C (the pre-fix shape) would leave the
// decrement/store BEFORE the select, firing it one extra time -> silent
// miscompile (gcc 3 vs pipeline 2). See incrementH-artifacts/oracle.sh (brk.c).
//
// RUN: cir-opt %s --cir-goto-solver --cir-canonicalize --cir-lower-break-continue | FileCheck %s
// RUN: cir-opt %s --cir-goto-solver --cir-canonicalize --cir-lower-break-continue --cir-lower-return --cir-canonicalize --cir-to-mlir | FileCheck %s --check-prefix=SCF

!s32i = !cir.int<s, 32>
module {
  cir.func @f() -> !s32i {
    %0 = cir.alloca "n" align(4) init : !cir.ptr<!s32i>
    %1 = cir.alloca "cnt" align(4) init : !cir.ptr<!s32i>
    %2 = cir.const #cir.int<5> : !s32i
    cir.store %2, %0 : !s32i, !cir.ptr<!s32i>
    %3 = cir.const #cir.int<0> : !s32i
    cir.store %3, %1 : !s32i, !cir.ptr<!s32i>
    cir.scope {
      cir.while {
        %5 = cir.load %0 : !cir.ptr<!s32i>, !s32i
        %6 = cir.dec nsw %5 : !s32i
        cir.store %6, %0 : !s32i, !cir.ptr<!s32i>
        %7 = cir.const #cir.int<0> : !s32i
        %8 = cir.cmp gt %5, %7 : !s32i
        cir.condition(%8)
      } do {
        cir.scope {
          %5 = cir.load %1 : !cir.ptr<!s32i>, !s32i
          %6 = cir.inc nsw %5 : !s32i
          cir.store %6, %1 : !s32i, !cir.ptr<!s32i>
          %7 = cir.const #cir.int<2> : !s32i
          %9 = cir.cmp eq %6, %7 : !s32i
          cir.if %9 {
            cir.break
          }
        }
        cir.yield
      }
    }
    %4 = cir.load %0 : !cir.ptr<!s32i>, !s32i
    cir.return %4 : !s32i
  }
}

// The condition region loads the brk flag, then a lazy ternary whose FALSE
// region holds the sunk side effect (dec + store) -- so the decrement runs only
// when brk is clear. Critically, there must be NO cir.store to the countdown
// slot ahead of the ternary in the cond region.
// CHECK: cir.while {
// CHECK: cir.load {{.*}} : !cir.ptr<!cir.bool>, !cir.bool
// CHECK: cir.ternary
// CHECK: true {
// CHECK: cir.const #false
// CHECK: }, false {
// CHECK: cir.dec
// CHECK: cir.store
// CHECK: cir.cmp gt
// CHECK: cir.yield
// CHECK: cir.condition

// The lazy condition lowers cleanly through to SCF (scf.if inside the while
// before-region computes the condition; the decrement is guarded by it).
// SCF: scf.while
// SCF: scf.if
