// Union type-punning via cir.get_member (write member `ll` as u64, read member
// `d` as double from the SAME storage -- a bit reinterpretation) is NOT yet
// supported by the ThroughMLIR memref lowering: a union has no memref storage
// model, so the member pointer cannot be materialized. It is honestly REJECTED
// (a failed unresolved materialization -- a hard error, never a silent
// miscompile), NOT lowered. This is the dfdiv/dfmul `ullong_to_double` wall;
// sound union support is owned by the struct/record lowering cluster.
//
// RUN: not cir-opt %s --cir-to-mlir 2>&1 | FileCheck %s

!u64i = !cir.int<u, 64>
!rec = !cir.union<"anon.0" {!cir.double, !u64i}>
module @m {
  cir.func @ullong_to_double(%arg0: !u64i) -> !cir.double {
    %0 = cir.alloca "t" align(8) : !cir.ptr<!rec>
    %1 = cir.get_member %0[1] {name = "ll"} : !cir.ptr<!rec> -> !cir.ptr<!u64i>
    cir.store align(8) %arg0, %1 : !u64i, !cir.ptr<!u64i>
    %2 = cir.get_member %0[0] {name = "d"} : !cir.ptr<!rec> -> !cir.ptr<!cir.double>
    %3 = cir.load align(8) %2 : !cir.ptr<!cir.double>, !cir.double
    cir.return %3 : !cir.double
  }
}

// CHECK: failed to legalize
