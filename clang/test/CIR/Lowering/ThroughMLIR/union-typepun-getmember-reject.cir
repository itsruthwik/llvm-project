// A MIXED-bit-width union (double [64] vs u8 [8]) cannot be scalarized to a
// single same-width storage cell -- the bit reinterpretation between differing
// widths is not representable -- so `--cir-lower-union-punning` honestly
// REJECTS it with a named diagnostic (a hard error, never a silent
// miscompile). Sound support for such a case would need a byte-addressed
// storage model owned by the struct/record lowering cluster.
//
// RUN: not cir-opt %s --cir-lower-union-punning 2>&1 | FileCheck %s

!u8i = !cir.int<u, 8>
!rec = !cir.union<"anon.0" {!cir.double, !u8i}>
module @m {
  cir.func @punmix(%arg0: !u8i) -> !cir.double {
    %0 = cir.alloca "t" align(8) : !cir.ptr<!rec>
    %1 = cir.get_member %0[1] {name = "b"} : !cir.ptr<!rec> -> !cir.ptr<!u8i>
    cir.store align(1) %arg0, %1 : !u8i, !cir.ptr<!u8i>
    %2 = cir.get_member %0[0] {name = "d"} : !cir.ptr<!rec> -> !cir.ptr<!cir.double>
    %3 = cir.load align(8) %2 : !cir.ptr<!cir.double>, !cir.double
    cir.return %3 : !cir.double
  }
}

// CHECK: differing bit width
