// FlattenScopeGoto: a multi-target forward-goto ladder (several nested gotos into
// a forward acyclic chain of function-body-level label blocks, reachable only by
// goto, no cross-block SSA -- the softfloat subFloat64Sigs shape) is structurized
// into a flag-guarded cir.if sequence gated by a shared `ladder_took` flag. No
// cir.goto or cir.label survives; downstream --cir-to-mlir then lowers cleanly.
//
// RUN: cir-opt %s --cir-flatten-scope-goto | FileCheck %s
//
// CHECK-LABEL: cir.func{{.*}}@classify
// CHECK: cir.alloca{{.*}}ladder_took
// CHECK-NOT: cir.goto
// CHECK-NOT: cir.label
!s32i = !cir.int<s, 32>
#loc3 = loc("/tmp/tmp.9kqptV1NJy/l.c":1:14)
#loc4 = loc("/tmp/tmp.9kqptV1NJy/l.c":1:18)
#loc5 = loc("/tmp/tmp.9kqptV1NJy/l.c":1:21)
#loc6 = loc("/tmp/tmp.9kqptV1NJy/l.c":1:25)
#loc45 = loc(fused[#loc3, #loc4])
#loc46 = loc(fused[#loc5, #loc6])
module @"/tmp/tmp.9kqptV1NJy/l.c" attributes {cir.lang = #cir.lang<c>, cir.module_asm = [], cir.triple = "x86_64-unknown-linux-gnu", dlti.dl_spec = #dlti.dl_spec<!llvm.ptr<270> = dense<32> : vector<4xi64>, !llvm.ptr<271> = dense<32> : vector<4xi64>, !llvm.ptr<272> = dense<64> : vector<4xi64>, i64 = dense<64> : vector<2xi64>, i128 = dense<128> : vector<2xi64>, f80 = dense<128> : vector<2xi64>, !llvm.ptr = dense<64> : vector<4xi64>, i1 = dense<8> : vector<2xi64>, i8 = dense<8> : vector<2xi64>, i16 = dense<16> : vector<2xi64>, i32 = dense<32> : vector<2xi64>, f16 = dense<16> : vector<2xi64>, f64 = dense<64> : vector<2xi64>, f128 = dense<128> : vector<2xi64>, "dlti.endianness" = "little", "dlti.mangling_mode" = "e", "dlti.legal_int_widths" = array<i32: 8, 16, 32, 64>, "dlti.stack_alignment" = 128 : i64>} {
  cir.func no_inline dso_local @classify(%arg0: !s32i {llvm.noundef} loc(fused[#loc3, #loc4]), %arg1: !s32i {llvm.noundef} loc(fused[#loc5, #loc6])) -> !s32i attributes {"cir.target-cpu" = "x86-64", "cir.target-features" = "+cmov,+cx8,+fxsr,+mmx,+sse,+sse2,+x87", "cir.tune-cpu" = "generic", nothrow} {
    %0 = cir.alloca "a" align(4) init : !cir.ptr<!s32i> loc(#loc45)
    %1 = cir.alloca "b" align(4) init : !cir.ptr<!s32i> loc(#loc46)
    %2 = cir.alloca "__retval" align(4) : !cir.ptr<!s32i> loc(#loc2)
    %3 = cir.alloca "r" align(4) init : !cir.ptr<!s32i> loc(#loc47)
    cir.store %arg0, %0 : !s32i, !cir.ptr<!s32i> loc(#loc9)
    cir.store %arg1, %1 : !s32i, !cir.ptr<!s32i> loc(#loc9)
    %4 = cir.const #cir.int<0> : !s32i loc(#loc8)
    cir.store align(4) %4, %3 : !s32i, !cir.ptr<!s32i> loc(#loc47)
    cir.scope {
      %19 = cir.load align(4) %0 : !cir.ptr<!s32i>, !s32i loc(#loc12)
      %20 = cir.load align(4) %1 : !cir.ptr<!s32i>, !s32i loc(#loc13)
      %21 = cir.cmp gt %19, %20 : !s32i loc(#loc14)
      cir.if %21 {
        cir.goto "aBig" loc(#loc49)
      } loc(#loc49)
    } loc(#loc48)
    cir.scope {
      %19 = cir.load align(4) %0 : !cir.ptr<!s32i>, !s32i loc(#loc18)
      %20 = cir.load align(4) %1 : !cir.ptr<!s32i>, !s32i loc(#loc19)
      %21 = cir.cmp lt %19, %20 : !s32i loc(#loc20)
      cir.if %21 {
        cir.goto "bBig" loc(#loc51)
      } loc(#loc51)
    } loc(#loc50)
    %5 = cir.const #cir.int<100> : !s32i loc(#loc22)
    cir.store align(4) %5, %3 : !s32i, !cir.ptr<!s32i> loc(#loc52)
    %6 = cir.load align(4) %3 : !cir.ptr<!s32i>, !s32i loc(#loc24)
    cir.store %6, %2 : !s32i, !cir.ptr<!s32i> loc(#loc53)
    %7 = cir.load %2 : !cir.ptr<!s32i>, !s32i loc(#loc53)
    cir.return %7 : !s32i loc(#loc53)
  ^bb1:  // no predecessors
    cir.label "aBig" loc(#loc26)
    %8 = cir.const #cir.int<1> : !s32i loc(#loc27)
    %9 = cir.load align(4) %3 : !cir.ptr<!s32i>, !s32i loc(#loc28)
    %10 = cir.add nsw %9, %8 : !s32i loc(#loc54)
    cir.store align(4) %10, %3 : !s32i, !cir.ptr<!s32i> loc(#loc54)
    cir.goto "done" loc(#loc55)
  ^bb2:  // no predecessors
    cir.label "bBig" loc(#loc32)
    %11 = cir.const #cir.int<2> : !s32i loc(#loc33)
    %12 = cir.load align(4) %3 : !cir.ptr<!s32i>, !s32i loc(#loc34)
    %13 = cir.add nsw %12, %11 : !s32i loc(#loc56)
    cir.store align(4) %13, %3 : !s32i, !cir.ptr<!s32i> loc(#loc56)
    cir.goto "done" loc(#loc57)
  ^bb3:  // no predecessors
    cir.label "done" loc(#loc38)
    %14 = cir.const #cir.int<1000> : !s32i loc(#loc39)
    %15 = cir.load align(4) %3 : !cir.ptr<!s32i>, !s32i loc(#loc40)
    %16 = cir.add nsw %15, %14 : !s32i loc(#loc58)
    cir.store align(4) %16, %3 : !s32i, !cir.ptr<!s32i> loc(#loc58)
    %17 = cir.load align(4) %3 : !cir.ptr<!s32i>, !s32i loc(#loc42)
    cir.store %17, %2 : !s32i, !cir.ptr<!s32i> loc(#loc59)
    %18 = cir.load %2 : !cir.ptr<!s32i>, !s32i loc(#loc59)
    cir.return %18 : !s32i loc(#loc59)
  } loc(#loc44)
} loc(#loc)
