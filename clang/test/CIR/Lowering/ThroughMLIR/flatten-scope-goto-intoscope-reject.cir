// Into-scope goto (target label nested below the function-body level, in a
// sibling scope not enclosing the goto) is rejected.
//
// RUN: cir-opt %s --cir-flatten-scope-goto -verify-diagnostics

!s32i = !cir.int<s, 32>
!u32i = !cir.int<u, 32>
module {
  cir.func no_inline dso_local @into_scope(%arg0: !s32i) -> !s32i {
    %0 = cir.alloca "c" align(4) init : !cir.ptr<!s32i>
    %1 = cir.alloca "r" align(4) init : !cir.ptr<!s32i>
    cir.store %arg0, %0 : !s32i, !cir.ptr<!s32i>
    %2 = cir.const #cir.int<0> : !s32i
    cir.store align(4) %2, %1 : !s32i, !cir.ptr<!s32i>
    cir.scope {
      %4 = cir.load align(4) %0 : !cir.ptr<!s32i>, !s32i
      %5 = cir.cast int_to_bool %4 : !s32i -> !cir.bool
      cir.if %5 {
      // expected-error @+1 {{unsupported 'goto' (into-scope goto}}
        cir.goto "inside"
      }
    }
    cir.scope {
      %4 = cir.const #cir.int<5> : !s32i
      cir.store align(4) %4, %1 : !s32i, !cir.ptr<!s32i>
      cir.br ^bb1
    ^bb1:  // pred: ^bb0
      cir.label "inside"
      %5 = cir.const #cir.int<1> : !s32i
      %6 = cir.load align(4) %1 : !cir.ptr<!s32i>, !s32i
      %7 = cir.add nsw %6, %5 : !s32i
      cir.store align(4) %7, %1 : !s32i, !cir.ptr<!s32i>
      cir.yield
    }
    %3 = cir.load align(4) %1 : !cir.ptr<!s32i>, !s32i
    cir.return %3 : !s32i
  }
}
