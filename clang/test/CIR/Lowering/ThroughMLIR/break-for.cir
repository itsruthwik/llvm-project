// break-in-for: the loop condition is strengthened with a lazy cir.ternary and the
// STEP region body is wrapped in `if(!brk)` so the step is SKIPPED on break
// (the break asymmetry). Then it lowers cleanly to scf.
//
// RUN: cir-opt %s --cir-goto-solver --cir-canonicalize --cir-lower-break-continue | FileCheck %s
// RUN: cir-opt %s --cir-goto-solver --cir-canonicalize --cir-lower-break-continue --cir-canonicalize --cir-to-mlir | FileCheck %s --check-prefix=SCF

!s32i = !cir.int<s, 32>
module {
  cir.func @f(%arg0: !s32i) -> !s32i {
    %0 = cir.alloca "n" align(4) init : !cir.ptr<!s32i>
    %2 = cir.alloca "s" align(4) init : !cir.ptr<!s32i>
    cir.store %arg0, %0 : !s32i, !cir.ptr<!s32i>
    %3 = cir.const #cir.int<0> : !s32i
    cir.store %3, %2 : !s32i, !cir.ptr<!s32i>
    cir.scope {
      %6 = cir.alloca "i" align(4) init : !cir.ptr<!s32i>
      cir.store %3, %6 : !s32i, !cir.ptr<!s32i>
      cir.for : cond {
        %8 = cir.load %6 : !cir.ptr<!s32i>, !s32i
        %9 = cir.load %0 : !cir.ptr<!s32i>, !s32i
        %10 = cir.cmp lt %8, %9 : !s32i
        cir.condition(%10)
      } body {
        %14 = cir.load %6 : !cir.ptr<!s32i>, !s32i
        %15 = cir.load %2 : !cir.ptr<!s32i>, !s32i
        %16 = cir.add nsw %15, %14 : !s32i
        cir.store %16, %2 : !s32i, !cir.ptr<!s32i>
        %12 = cir.const #cir.int<100> : !s32i
        %13 = cir.cmp gt %16, %12 : !s32i
        cir.if %13 {
          cir.break
        }
        cir.yield
      } step {
        %8 = cir.load %6 : !cir.ptr<!s32i>, !s32i
        %9 = cir.inc nsw %8 : !s32i
        cir.store %9, %6 : !s32i, !cir.ptr<!s32i>
        cir.yield
      }
    }
    %4 = cir.load %2 : !cir.ptr<!s32i>, !s32i
    cir.return %4 : !s32i
  }
}

// CHECK: cir.alloca {{.*}}"brk"
// The condition is strengthened lazily: brk ? false : <cmp>, with <cmp> sunk
// into the ternary's false region (evaluated only when brk is clear).
// CHECK: cir.for : cond {
// CHECK: cir.ternary
// CHECK: cir.const #false
// CHECK: false {
// CHECK: cir.condition
// The step is guarded so it is SKIPPED on break.
// CHECK: } step {
// CHECK: cir.if
// CHECK: cir.inc

// SCF: scf.while
