// A conditional merge whose BOTH sides reduce to the SAME root (different
// offsets) is IN scope: the slot still has a single base object, so the
// merge is just two different index stores.
//
// RUN: cir-opt %s --cir-lower-pointer-cursors | FileCheck %s

!s32i = !cir.int<s, 32>
module {
  cir.func @merge(%c: !cir.bool) -> !s32i {
    %a = cir.alloca "a" align(16) : !cir.ptr<!cir.array<!s32i x 8>>
    %p = cir.alloca "p" align(8) : !cir.ptr<!cir.ptr<!s32i>>
    cir.if %c {
      %d = cir.cast array_to_ptrdecay %a : !cir.ptr<!cir.array<!s32i x 8>> -> !cir.ptr<!s32i>
      cir.store align(8) %d, %p : !cir.ptr<!s32i>, !cir.ptr<!cir.ptr<!s32i>>
    } else {
      %d = cir.cast array_to_ptrdecay %a : !cir.ptr<!cir.array<!s32i x 8>> -> !cir.ptr<!s32i>
      %k = cir.const #cir.int<4> : !s32i
      %q = cir.ptr_stride %d, %k : (!cir.ptr<!s32i>, !s32i) -> !cir.ptr<!s32i>
      cir.store align(8) %q, %p : !cir.ptr<!s32i>, !cir.ptr<!cir.ptr<!s32i>>
    }
    %0 = cir.load deref align(8) %p : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
    %1 = cir.load align(4) %0 : !cir.ptr<!s32i>, !s32i
    cir.return %1 : !s32i
  }
}

// CHECK-NOT: !cir.ptr<!cir.ptr<!s32i>>
// CHECK: %[[A:.+]] = cir.alloca "a"
// CHECK: cir.if
// CHECK: cir.const #cir.int<0> : !s32i
// CHECK: cir.const #cir.int<4> : !s32i
// CHECK: cir.get_element %[[A]][{{.*}}]
