// R-3 REGRESSION GUARD (the historical for+continue silent miscompile).
//
// A `continue` in a C `for` loop must STILL execute the loop step (e.g. i++):
// control jumps to the step, then the condition. --cir-lower-break-continue
// rewrites the continue into a body-local `cont` flag + guard-climb and leaves
// the cond and step regions UNTOUCHED, so the step still runs on continue.
//
// This test fails loudly if someone re-introduces a step-inside-the-guard
// lowering: the step's increment must NOT sit inside a `cir.if` guard region.
//
// RUN: cir-opt %s --cir-goto-solver --cir-canonicalize --cir-lower-break-continue | FileCheck %s
// RUN: cir-opt %s --cir-goto-solver --cir-canonicalize --cir-lower-break-continue --cir-canonicalize --cir-to-mlir | FileCheck %s --check-prefix=SCF

!s32i = !cir.int<s, 32>
module {
  cir.func @f(%arg0: !s32i) -> !s32i {
    %0 = cir.alloca "n" align(4) init : !cir.ptr<!s32i>
    %2 = cir.alloca "s" align(4) init : !cir.ptr<!s32i>
    cir.store %arg0, %0 : !s32i, !cir.ptr<!s32i>
    %3 = cir.const #cir.int<0> : !s32i
    cir.store %3, %2 : !s32i, !cir.ptr<!s32i>
    cir.scope {
      %6 = cir.alloca "i" align(4) init : !cir.ptr<!s32i>
      cir.store %3, %6 : !s32i, !cir.ptr<!s32i>
      cir.for : cond {
        %8 = cir.load %6 : !cir.ptr<!s32i>, !s32i
        %9 = cir.load %0 : !cir.ptr<!s32i>, !s32i
        %10 = cir.cmp lt %8, %9 : !s32i
        cir.condition(%10)
      } body {
        %11 = cir.load %6 : !cir.ptr<!s32i>, !s32i
        %12 = cir.const #cir.int<3> : !s32i
        %13 = cir.cmp eq %11, %12 : !s32i
        cir.if %13 {
          cir.continue
        }
        %14 = cir.load %6 : !cir.ptr<!s32i>, !s32i
        %15 = cir.load %2 : !cir.ptr<!s32i>, !s32i
        %16 = cir.add nsw %15, %14 : !s32i
        cir.store %16, %2 : !s32i, !cir.ptr<!s32i>
        cir.yield
      } step {
        %8 = cir.load %6 : !cir.ptr<!s32i>, !s32i
        %9 = cir.inc nsw %8 : !s32i
        cir.store %9, %6 : !s32i, !cir.ptr<!s32i>
        cir.yield
      }
    }
    %4 = cir.load %2 : !cir.ptr<!s32i>, !s32i
    cir.return %4 : !s32i
  }
}

// The continue becomes a `cont` flag; the trailing body is guarded by if(!cont).
// CHECK: cir.alloca {{.*}}"cont"
// CHECK: cir.for : cond {
// The step region is the LAST region and must NOT contain a guard `cir.if`:
// the increment executes unconditionally on every iteration (incl. continue).
// CHECK: } step {
// CHECK-NOT: cir.if
// CHECK: cir.inc
// CHECK: }

// Removing the continue makes the loop canonical again -> scf.for, and the
// induction step is the scf.for step (unconditional), never a guarded body op.
// SCF: scf.for
