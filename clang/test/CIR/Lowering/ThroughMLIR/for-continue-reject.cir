// REGRESSION GUARD (R-3, the historical for+continue silent miscompile).
//
// A `continue` in a C `for` loop must STILL execute the loop step (e.g. i++):
// control jumps to the step, then the condition. The old ad-hoc flag machinery
// appended the step to the body end and then guarded "everything after the
// continue" with `if (!continue_flag)` -- which SWEPT THE STEP into the guard,
// so the induction variable never advanced -> infinite loop / silent
// miscompile.
//
// Until a CFG-correct for+continue lowering lands (step OUTSIDE the guard),
// this MUST be rejected with an honest diagnostic rather than miscompiled.
// This test fails loudly if someone re-enables the miscompiling path without
// moving the step out of the continue guard.
//
// RUN: not cir-opt %s --cir-goto-solver --cir-canonicalize --cir-to-mlir 2>&1 | FileCheck %s

!s32i = !cir.int<s, 32>
module {
  cir.func @f(%arg0: !s32i) -> !s32i {
    %0 = cir.alloca "n" align(4) init : !cir.ptr<!s32i>
    %2 = cir.alloca "s" align(4) init : !cir.ptr<!s32i>
    cir.store %arg0, %0 : !s32i, !cir.ptr<!s32i>
    %3 = cir.const #cir.int<0> : !s32i
    cir.store %3, %2 : !s32i, !cir.ptr<!s32i>
    cir.scope {
      %6 = cir.alloca "i" align(4) init : !cir.ptr<!s32i>
      cir.store %3, %6 : !s32i, !cir.ptr<!s32i>
      cir.for : cond {
        %8 = cir.load %6 : !cir.ptr<!s32i>, !s32i
        %9 = cir.load %0 : !cir.ptr<!s32i>, !s32i
        %10 = cir.cmp lt %8, %9 : !s32i
        cir.condition(%10)
      } body {
        %11 = cir.load %6 : !cir.ptr<!s32i>, !s32i
        %12 = cir.const #cir.int<3> : !s32i
        %13 = cir.cmp eq %11, %12 : !s32i
        cir.if %13 {
          cir.continue
        }
        %14 = cir.load %6 : !cir.ptr<!s32i>, !s32i
        %15 = cir.load %2 : !cir.ptr<!s32i>, !s32i
        %16 = cir.add nsw %15, %14 : !s32i
        cir.store %16, %2 : !s32i, !cir.ptr<!s32i>
        cir.yield
      } step {
        %8 = cir.load %6 : !cir.ptr<!s32i>, !s32i
        %9 = cir.inc nsw %8 : !s32i
        cir.store %9, %6 : !s32i, !cir.ptr<!s32i>
        cir.yield
      }
    }
    %4 = cir.load %2 : !cir.ptr<!s32i>, !s32i
    cir.return %4 : !s32i
  }
}

// CHECK: error: ThroughMLIR: 'continue' inside a 'for' loop is not yet supported
// CHECK-NOT: scf.while
