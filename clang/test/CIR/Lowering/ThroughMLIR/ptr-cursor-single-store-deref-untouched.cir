// A trivial single-store pointer slot whose loads only feed dereferences
// (the argument-copy slot of every pointer parameter) is NOT cursor-like and
// is deliberately LEFT UNTOUCHED: it is handled by the existing lowering
// today, and rewriting it would churn every kernel (the pass stays additive).
//
// RUN: cir-opt %s --cir-lower-pointer-cursors | FileCheck %s

!s32i = !cir.int<s, 32>
module {
  cir.func @argcopy(%arg0: !cir.ptr<!s32i>) -> !s32i {
    %p = cir.alloca "b" align(8) : !cir.ptr<!cir.ptr<!s32i>>
    cir.store align(8) %arg0, %p : !cir.ptr<!s32i>, !cir.ptr<!cir.ptr<!s32i>>
    %0 = cir.load deref align(8) %p : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
    %1 = cir.load align(4) %0 : !cir.ptr<!s32i>, !s32i
    cir.return %1 : !s32i
  }
}

// CHECK: cir.alloca "b" {{.*}} : !cir.ptr<!cir.ptr<!s32i>>
// CHECK: cir.store align(8) %arg0
