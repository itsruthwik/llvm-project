// void function with a nested early return: a `returning` flag is created but
// NO retval alloca (nothing to return); the tail is a bare cir.return.
//
// RUN: cir-opt %s --cir-lower-return | FileCheck %s
// RUN: cir-opt %s --cir-lower-return --cir-canonicalize --cir-to-mlir | FileCheck %s --check-prefix=SCF

!s32i = !cir.int<s, 32>
!s64i = !cir.int<s, 64>
module {
  cir.func @f(%arg0: !cir.ptr<!s32i> {llvm.noundef}, %arg1: !s32i {llvm.noundef}) {
    %0 = cir.alloca "p" align(8) init : !cir.ptr<!cir.ptr<!s32i>>
    %1 = cir.alloca "x" align(4) init : !cir.ptr<!s32i>
    cir.store %arg0, %0 : !cir.ptr<!s32i>, !cir.ptr<!cir.ptr<!s32i>>
    cir.store %arg1, %1 : !s32i, !cir.ptr<!s32i>
    cir.scope {
      %2 = cir.alloca "i" align(4) init : !cir.ptr<!s32i>
      %3 = cir.const #cir.int<0> : !s32i
      cir.store align(4) %3, %2 : !s32i, !cir.ptr<!s32i>
      cir.for : cond {
        %4 = cir.load align(4) %2 : !cir.ptr<!s32i>, !s32i
        %5 = cir.load align(4) %1 : !cir.ptr<!s32i>, !s32i
        %6 = cir.cmp lt %4, %5 : !s32i
        cir.condition(%6)
      } body {
        cir.scope {
          %4 = cir.load align(4) %2 : !cir.ptr<!s32i>, !s32i
          %5 = cir.load align(4) %2 : !cir.ptr<!s32i>, !s32i
          %6 = cir.cast integral %5 : !s32i -> !s64i
          %7 = cir.load align(8) %0 : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
          %8 = cir.ptr_stride %7, %6 : (!cir.ptr<!s32i>, !s64i) -> !cir.ptr<!s32i>
          cir.store align(4) %4, %8 : !s32i, !cir.ptr<!s32i>
          cir.scope {
            %9 = cir.load align(4) %2 : !cir.ptr<!s32i>, !s32i
            %10 = cir.const #cir.int<3> : !s32i
            %11 = cir.cmp eq %9, %10 : !s32i
            cir.if %11 {
              cir.return
            }
          }
        }
        cir.yield
      } step {
        %4 = cir.load align(4) %2 : !cir.ptr<!s32i>, !s32i
        %5 = cir.inc nsw %4 : !s32i
        cir.store align(4) %5, %2 : !s32i, !cir.ptr<!s32i>
        cir.yield
      }
    }
    cir.return
  }
}

// CHECK: cir.alloca {{.*}}"returning"
// CHECK-NOT: cir.alloca {{.*}}"retval"
// CHECK: cir.select if
// SCF: func.func @f
// SCF: return
