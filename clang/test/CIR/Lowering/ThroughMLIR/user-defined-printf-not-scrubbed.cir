// A user-defined function named `printf` (with a body) collides with the libc
// output-sink name, but it is ordinary code -- ScrubIO's externality gate must
// NOT scrub/erase it (only external declarations are libc I/O).
//
// RUN: cir-opt %s --cir-scrub-io | FileCheck %s

!s32i = !cir.int<s, 32>
module @m {
  // User-defined `printf` WITH a body -- not a libc declaration.
  cir.func dso_local @printf(%arg0: !s32i) -> !s32i {
    %0 = cir.alloca "__retval" align(4) : !cir.ptr<!s32i>
    cir.store %arg0, %0 : !s32i, !cir.ptr<!s32i>
    %1 = cir.load %0 : !cir.ptr<!s32i>, !s32i
    cir.return %1 : !s32i
  }
  cir.func dso_local @f(%arg0: !s32i) -> !s32i {
    %r = cir.call @printf(%arg0) : (!s32i) -> !s32i
    cir.return %r : !s32i
  }
}

// CHECK: cir.call @printf
