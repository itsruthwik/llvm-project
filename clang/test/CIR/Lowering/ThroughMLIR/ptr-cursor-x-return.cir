// CROSS-FEATURE: pointer cursor x RETURN. An early return inside a cursor
// loop is rewritten by --cir-lower-return AFTER the cursor pass; the combined
// chain lowers to memref/scf with an integer loop condition.
//
// C shape: while(p<end){ if(*p==6) return 100; p++; } return 0;
//
// RUN: cir-opt %s --cir-lower-pointer-cursors --cir-flatten-scope-goto --cir-goto-solver --cir-canonicalize --cir-lower-break-continue --cir-lower-return --cir-canonicalize --cir-to-mlir | FileCheck %s

!s32i = !cir.int<s, 32>
!s64i = !cir.int<s, 64>
module {
  cir.func  @f() -> !s32i {
    %0 = cir.alloca "__retval" align(4) : !cir.ptr<!s32i>
    %1 = cir.alloca "a" align(16) : !cir.ptr<!cir.array<!s32i x 8>>
    %2 = cir.alloca "p" align(8) init : !cir.ptr<!cir.ptr<!s32i>>
    %3 = cir.alloca "end" align(8) init : !cir.ptr<!cir.ptr<!s32i>>
    cir.scope {
      %10 = cir.alloca "i" align(4) init : !cir.ptr<!s32i>
      %11 = cir.const #cir.int<0> : !s32i
      cir.store align(4) %11, %10 : !s32i, !cir.ptr<!s32i>
      cir.for : cond {
        %12 = cir.load align(4) %10 : !cir.ptr<!s32i>, !s32i
        %13 = cir.const #cir.int<8> : !s32i
        %14 = cir.cmp lt %12, %13 : !s32i
        cir.condition(%14)
      } body {
        %12 = cir.load align(4) %10 : !cir.ptr<!s32i>, !s32i
        %13 = cir.load align(4) %10 : !cir.ptr<!s32i>, !s32i
        %14 = cir.cast integral %13 : !s32i -> !s64i
        %15 = cir.get_element %1[%14 : !s64i] : !cir.ptr<!cir.array<!s32i x 8>> -> !cir.ptr<!s32i>
        cir.store align(4) %12, %15 : !s32i, !cir.ptr<!s32i>
        cir.yield
      } step {
        %12 = cir.load align(4) %10 : !cir.ptr<!s32i>, !s32i
        %13 = cir.inc nsw %12 : !s32i
        cir.store align(4) %13, %10 : !s32i, !cir.ptr<!s32i>
        cir.yield
      }
    }
    %4 = cir.cast array_to_ptrdecay %1 : !cir.ptr<!cir.array<!s32i x 8>> -> !cir.ptr<!s32i>
    cir.store align(8) %4, %2 : !cir.ptr<!s32i>, !cir.ptr<!cir.ptr<!s32i>>
    %5 = cir.cast array_to_ptrdecay %1 : !cir.ptr<!cir.array<!s32i x 8>> -> !cir.ptr<!s32i>
    %6 = cir.const #cir.int<8> : !s32i
    %7 = cir.ptr_stride %5, %6 : (!cir.ptr<!s32i>, !s32i) -> !cir.ptr<!s32i>
    cir.store align(8) %7, %3 : !cir.ptr<!s32i>, !cir.ptr<!cir.ptr<!s32i>>
    cir.scope {
      cir.while {
        %10 = cir.load align(8) %2 : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
        %11 = cir.load align(8) %3 : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
        %12 = cir.cmp lt %10, %11 : !cir.ptr<!s32i>
        cir.condition(%12)
      } do {
        cir.scope {
          cir.scope {
            %13 = cir.load deref align(8) %2 : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
            %14 = cir.load align(4) %13 : !cir.ptr<!s32i>, !s32i
            %15 = cir.const #cir.int<6> : !s32i
            %16 = cir.cmp eq %14, %15 : !s32i
            cir.if %16 {
              %17 = cir.const #cir.int<100> : !s32i
              cir.store %17, %0 : !s32i, !cir.ptr<!s32i>
              %18 = cir.load %0 : !cir.ptr<!s32i>, !s32i
              cir.return %18 : !s32i
            }
          }
          %10 = cir.load align(8) %2 : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
          %11 = cir.const #cir.int<1> : !s32i
          %12 = cir.ptr_stride %10, %11 : (!cir.ptr<!s32i>, !s32i) -> !cir.ptr<!s32i>
          cir.store align(8) %12, %2 : !cir.ptr<!s32i>, !cir.ptr<!cir.ptr<!s32i>>
        }
        cir.yield
      }
    }
    %8 = cir.const #cir.int<0> : !s32i
    cir.store %8, %0 : !s32i, !cir.ptr<!s32i>
    %9 = cir.load %0 : !cir.ptr<!s32i>, !s32i
    cir.return %9 : !s32i
  }
}


// Fully lowered: no cir ops, no fat-pointer memrefs, integer loop machinery.
// CHECK: func.func @f
// CHECK-NOT: cir.
// CHECK-NOT: memref<1xmemref
// CHECK: return
