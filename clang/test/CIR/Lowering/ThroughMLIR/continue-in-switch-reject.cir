// continue-inside-switch-inside-loop must climb out through a cir.switch case
// region. That cross-switch guard-climb is intentionally unsupported (no
// benchmark needs it) and is honestly rejected.
//
// RUN: not cir-opt %s --cir-goto-solver --cir-canonicalize --cir-lower-break-continue 2>&1 | FileCheck %s

!s32i = !cir.int<s, 32>
module @"/tmp/claude-757590189/-mnt-vault2-rsunketa-VTR-HLS-vtrhls/9fa3526c-e1f4-4ea5-bfd4-5f310730acba/scratchpad/cs.c" attributes {cir.lang = #cir.lang<c>, cir.module_asm = [], cir.triple = "x86_64-unknown-linux-gnu", dlti.dl_spec = #dlti.dl_spec<!llvm.ptr<270> = dense<32> : vector<4xi64>, !llvm.ptr<271> = dense<32> : vector<4xi64>, !llvm.ptr<272> = dense<64> : vector<4xi64>, i64 = dense<64> : vector<2xi64>, i128 = dense<128> : vector<2xi64>, f80 = dense<128> : vector<2xi64>, !llvm.ptr = dense<64> : vector<4xi64>, i1 = dense<8> : vector<2xi64>, i8 = dense<8> : vector<2xi64>, i16 = dense<16> : vector<2xi64>, i32 = dense<32> : vector<2xi64>, f16 = dense<16> : vector<2xi64>, f64 = dense<64> : vector<2xi64>, f128 = dense<128> : vector<2xi64>, "dlti.endianness" = "little", "dlti.mangling_mode" = "e", "dlti.legal_int_widths" = array<i32: 8, 16, 32, 64>, "dlti.stack_alignment" = 128 : i64>} {
  cir.func no_inline dso_local @f(%arg0: !s32i {llvm.noundef}) -> !s32i attributes {"cir.target-cpu" = "x86-64", "cir.target-features" = "+cmov,+cx8,+fxsr,+mmx,+sse,+sse2,+x87", "cir.tune-cpu" = "generic", nothrow} {
    %0 = cir.alloca "n" align(4) init : !cir.ptr<!s32i>
    %1 = cir.alloca "__retval" align(4) : !cir.ptr<!s32i>
    %2 = cir.alloca "s" align(4) init : !cir.ptr<!s32i>
    cir.store %arg0, %0 : !s32i, !cir.ptr<!s32i>
    %3 = cir.const #cir.int<0> : !s32i
    cir.store align(4) %3, %2 : !s32i, !cir.ptr<!s32i>
    cir.scope {
      %6 = cir.alloca "i" align(4) init : !cir.ptr<!s32i>
      %7 = cir.const #cir.int<0> : !s32i
      cir.store align(4) %7, %6 : !s32i, !cir.ptr<!s32i>
      cir.for : cond {
        %8 = cir.load align(4) %6 : !cir.ptr<!s32i>, !s32i
        %9 = cir.load align(4) %0 : !cir.ptr<!s32i>, !s32i
        %10 = cir.cmp lt %8, %9 : !s32i
        cir.condition(%10)
      } body {
        cir.scope {
          cir.scope {
            %8 = cir.load align(4) %6 : !cir.ptr<!s32i>, !s32i
            %9 = cir.const #cir.int<1> : !s32i
            %10 = cir.and %8, %9 : !s32i
            cir.switch(%10 : !s32i) {
              cir.case(equal, [#cir.int<0> : !s32i]) {
                cir.continue
              }
              cir.case(default, []) {
                %11 = cir.load align(4) %6 : !cir.ptr<!s32i>, !s32i
                %12 = cir.load align(4) %2 : !cir.ptr<!s32i>, !s32i
                %13 = cir.add nsw %12, %11 : !s32i
                cir.store align(4) %13, %2 : !s32i, !cir.ptr<!s32i>
                cir.yield
              }
              cir.yield
            }
          }
        }
        cir.yield
      } step {
        %8 = cir.load align(4) %6 : !cir.ptr<!s32i>, !s32i
        %9 = cir.inc nsw %8 : !s32i
        cir.store align(4) %9, %6 : !s32i, !cir.ptr<!s32i>
        cir.yield
      }
    }
    %4 = cir.load align(4) %2 : !cir.ptr<!s32i>, !s32i
    cir.store %4, %1 : !s32i, !cir.ptr<!s32i>
    %5 = cir.load %1 : !cir.ptr<!s32i>, !s32i
    cir.return %5 : !s32i
  }
}

// CHECK: error: ThroughMLIR: 'continue' inside a 'switch' inside a loop is not supported
