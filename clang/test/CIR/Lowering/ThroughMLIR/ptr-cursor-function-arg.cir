// A cursor rooted at an incoming pointer ARGUMENT rewrites dereferences to a
// single root-based ptr_stride (the argument has no array type to
// get_element into), with the cursor state kept as an integer index slot.
//
// RUN: cir-opt %s --cir-lower-pointer-cursors | FileCheck %s

!s32i = !cir.int<s, 32>
module {
  cir.func @sum(%arg0: !cir.ptr<!s32i>, %arg1: !s32i) -> !s32i {
    %p = cir.alloca "p" align(8) : !cir.ptr<!cir.ptr<!s32i>>
    %s = cir.alloca "s" align(4) : !cir.ptr<!s32i>
    cir.store align(8) %arg0, %p : !cir.ptr<!s32i>, !cir.ptr<!cir.ptr<!s32i>>
    %0 = cir.load deref align(8) %p : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
    %1 = cir.load align(4) %0 : !cir.ptr<!s32i>, !s32i
    cir.store align(4) %1, %s : !s32i, !cir.ptr<!s32i>
    %2 = cir.load align(8) %p : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
    %k = cir.const #cir.int<1> : !s32i
    %3 = cir.ptr_stride %2, %k : (!cir.ptr<!s32i>, !s32i) -> !cir.ptr<!s32i>
    cir.store align(8) %3, %p : !cir.ptr<!s32i>, !cir.ptr<!cir.ptr<!s32i>>
    %4 = cir.load deref align(8) %p : !cir.ptr<!cir.ptr<!s32i>>, !cir.ptr<!s32i>
    %5 = cir.load align(4) %4 : !cir.ptr<!s32i>, !s32i
    %6 = cir.load align(4) %s : !cir.ptr<!s32i>, !s32i
    %7 = cir.add %5, %6 : !s32i
    cir.return %7 : !s32i
  }
}

// CHECK-NOT: !cir.ptr<!cir.ptr<!s32i>>
// Dereferences go through a root-based stride on the argument.
// CHECK: cir.ptr_stride %arg0, %{{.+}} : (!cir.ptr<!s32i>, !s32i)
// CHECK: cir.add %{{.+}}, %{{.+}} : !s32i
// CHECK: cir.ptr_stride %arg0, %{{.+}} : (!cir.ptr<!s32i>, !s32i)
