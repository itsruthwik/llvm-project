// P0 regression (side-effecting loop condition + cross-scope forward goto).
// The while condition `n-- > 0` has a side effect; a `goto` exits the loop to a
// shared epilogue. --cir-flatten-scope-goto must strengthen the loop condition
// LAZILY (flag ? false : C, with C's decrement/store sunk into the ternary's
// false region) so the decrement never fires an extra time after the goto.
// Numeric oracle: incrementH-artifacts/oracle.sh (goto_se.c, gcc 3 == pipeline).
//
// RUN: cir-opt %s --cir-flatten-scope-goto | FileCheck %s
// RUN: cir-opt %s --cir-flatten-scope-goto --cir-goto-solver --cir-canonicalize --cir-lower-break-continue --cir-lower-return --cir-canonicalize --cir-to-mlir | FileCheck %s --check-prefix=SCF

!s32i = !cir.int<s, 32>
module {
  cir.func @f() -> !s32i {
    %0 = cir.alloca "n" align(4) init : !cir.ptr<!s32i>
    %1 = cir.alloca "c" align(4) init : !cir.ptr<!s32i>
    %2 = cir.const #cir.int<5> : !s32i
    cir.store %2, %0 : !s32i, !cir.ptr<!s32i>
    %3 = cir.const #cir.int<0> : !s32i
    cir.store %3, %1 : !s32i, !cir.ptr<!s32i>
    cir.scope {
      cir.while {
        %5 = cir.load %0 : !cir.ptr<!s32i>, !s32i
        %6 = cir.dec nsw %5 : !s32i
        cir.store %6, %0 : !s32i, !cir.ptr<!s32i>
        %7 = cir.const #cir.int<0> : !s32i
        %8 = cir.cmp gt %5, %7 : !s32i
        cir.condition(%8)
      } do {
        cir.scope {
          %5 = cir.load %1 : !cir.ptr<!s32i>, !s32i
          %6 = cir.inc nsw %5 : !s32i
          cir.store %6, %1 : !s32i, !cir.ptr<!s32i>
          %7 = cir.const #cir.int<2> : !s32i
          %9 = cir.cmp eq %6, %7 : !s32i
          cir.if %9 {
            cir.goto "done"
          }
        }
        cir.yield
      }
    }
    cir.br ^bb1
  ^bb1:
    cir.label "done"
    %4 = cir.load %0 : !cir.ptr<!s32i>, !s32i
    cir.return %4 : !s32i
  }
}

// CHECK: cir.while {
// CHECK: cir.load {{.*}} : !cir.ptr<!cir.bool>, !cir.bool
// CHECK: cir.ternary
// CHECK: }, false {
// CHECK: cir.dec
// CHECK: cir.store
// CHECK: cir.cmp gt
// CHECK: cir.yield
// CHECK: cir.condition

// SCF: scf.while
// SCF: scf.if
